{
  "name": "classicalmoser-oxlint-config",
  "version": "0.0.1",
  "description": "Shared strict oxlint standard for ClassicalMoser projects",
  "license": "ISC",
  "author": "ClassicalMoser",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./oxfmt": "./src/oxfmt.ts"
  },
  "scripts": {
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm lint && pnpm format && pnpm typecheck",
    "validate:check": "pnpm lint:check && pnpm format:check && pnpm typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.71.0"
  },
  "peerDependencies": {
    "eslint-plugin-command": ">=4.0.0",
    "eslint-plugin-import-boundaries": ">=0.8.3",
    "eslint-plugin-jsonc": ">=3.4.2",
    "eslint-plugin-regexp": ">=3.3.1",
    "eslint-plugin-solid": ">=0.18.0",
    "oxlint": ">=1.86.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-import-boundaries": {
      "optional": true
    },
    "eslint-plugin-solid": {
      "optional": true
    }
  }
}
